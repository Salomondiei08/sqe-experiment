\newcounter{@affilnum}
\newcommand{\printAffiliationsAndNotice}[1]{\global\pp@noticeprintedtrue%
  \stepcounter{@affiliationcounter}%
  {\let\thefootnote\relax\footnotetext{\hspace*{-\footnotesep}\ifppshowauthors #1\fi%
      \forloop{@affilnum}{1}{\value{@affilnum} < \value{@affiliationcounter}}{
        \textsuperscript{\arabic{@affilnum}}\ifcsname @affilname\the@affilnum\endcsname%
          \csname @affilname\the@affilnum\endcsname%
        \else
          {\bf AUTHORERR: Missing \textbackslash{}ppaffiliation.}
        \fi
      }.%
      \ifdefined\ppcorrespondingauthor@text
         { }Correspondence to: \ppcorrespondingauthor@text.
      \else
        {\bf AUTHORERR: Missing \textbackslash{}ppcorrespondingauthor.}
      \fi

      \ \\
      \Notice@String
    }
  }
}

