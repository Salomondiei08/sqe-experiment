\newcounter{@affiliationcounter}
\newcommand{\@pa}[1]{%
  \ifcsname the@affil#1\endcsname
    % do nothing
  \else
    \ifcsname @ppsymbol#1\endcsname
      % nothing
    \else
      \stepcounter{@affiliationcounter}%
      \newcounter{@affil#1}%
      \setcounter{@affil#1}{\value{@affiliationcounter}}%
    \fi
  \fi%
  \ifcsname @ppsymbol#1\endcsname
    \textsuperscript{\csname @ppsymbol#1\endcsname\,}%
  \else
    \textsuperscript{\arabic{@affil#1}\,}%
  \fi
}

\newcommand{\ppauthor}[2]{%
  \ifppshowauthors
    \mbox{\bf #1}\,\@for\theaffil:=#2\do{\@pa{\theaffil}} \addtofullauthorlist{#1}%
  \else
    \ifdefined\@ppfirsttime\else
      \gdef\@ppfirsttime{1}
      \mbox{\bf Anonymous Authors}\@pa{@anon} \addtofullauthorlist{Anonymous Authors}
    \fi
  \fi
}

\newcommand{\ppsetsymbol}[2]{%
  \expandafter\gdef\csname @ppsymbol#1\endcsname{#2}
}

\newcommand{\ppaffiliation}[2]{%
  \ifppshowauthors
    \ifcsname the@affil#1\endcsname
      \expandafter\gdef\csname @affilname\csname the@affil#1\endcsname\endcsname{#2}%
    \else
      {\bf AUTHORERR: Error in use of \textbackslash{}ppaffiliation command. Label ``#1'' not mentioned in some \textbackslash{}ppauthor\{author name\}\{labels here\} command beforehand. }
      \typeout{}%
      \typeout{}%
      \typeout{*******************************************************}%
      \typeout{Affiliation label undefined. }%
      \typeout{Make sure \string\ppaffiliation\space follows }%
      \typeout{all of \string\ppauthor\space commands}%
      \typeout{*******************************************************}%
      \typeout{}%
      \typeout{}%
    \fi
  \else
    \expandafter\gdef\csname @affilname1\endcsname{Anonymous Institution, Anonymous City, Anonymous Region, Anonymous Country}
  \fi
}

\newcommand{\ppcorrespondingauthor}[2]{%
  \ifppshowauthors
    \ifdefined\ppcorrespondingauthor@text
      \g@addto@macro\ppcorrespondingauthor@text{, #1 \textless{}#2\textgreater{}}
    \else
      \gdef\ppcorrespondingauthor@text{#1 \textless{}#2\textgreater{}}
    \fi
  \else
    \gdef\ppcorrespondingauthor@text{Anonymous Author \textless{}anon.email@domain.com\textgreater{}}
  \fi
}

